{% extends 'base.html.twig' %}

{% block title %}Lieux de déplacements{% endblock %}

{% block body %}
    <div class="intro-banner">
        <h1>Lieux de déplacements</h1>
        <p>Suis-je disponible dans votre ville ou commune ?</p>
    </div>

    <div class="separator"><span></span></div>

    <section class="location-page">
        <div class="location-card">

            <h2>Recherchez votre ville ou commune</h2>
            <p>Service de coiffure à domicile dans un rayon de 30 km autour de Quimperlé</p>

            <div id="popup-message" class="popup-message" style="display: none;"></div>

            {{ form_start(form, {'attr': {'id': 'location-form'}}) }}
            {{ form_widget(form) }}
            <button type="submit"><i class="fas fa-search"></i></button>
            {{ form_end(form) }}

            {% if locations is not empty %}
                <div class="location-results">
                    <h3>Résultats :</h3>
                    <ul>
                        {% for location in locations %}
                            <li>{{ location.city }} ({{ location.zipcode }})</li>
                        {% endfor %}
                    </ul>
                </div>
            {% elseif isSubmitted %}
                <p class="no-result">Aucun résultat trouvé.</p>
            {% endif %}

            <div id="map"></div>
        </div>
    </section>

    <div class="separator"><span></span></div>

    <div class="location-contact-banner">
        <h2>Votre ville ou commune n’est pas listée</h2>
        <p>Contactez-moi pour vérifier si j’interviens chez vous</p>
        <div class="contact-info">
            <p>Téléphone<br>06.40.75.81.29</p>
        </div>
    </div>

    <div class="separator"><span></span></div>

    {# === Bloc double-card : Coordonnées + prendre rdv === #}
    <section class="after-pricing-rdv">
        <div class="double-card">

            {# --- Carte 1 : Coordonnées --- #}
            <div class="card-box contact">
                <h3><strong>|</strong> Coordonnées</h3>

                <p class="contact-line">
                    <img src="{{ asset('images/icon-phone.png') }}" alt="Téléphone">
                    06.40.75.81.29
                </p>
                <p class="contact-line">
                    <img src="{{ asset('images/icon-mail.png') }}" alt="Email">
                    triskellhair@gmail.com
                </p>

                <p class="intro-line intro-name">Claire Perven, coiffeuse à domicile.</p>
                <p class="intro-line intro-zone">Dans une zone de 30 km autour de Quimperlé.</p>

                <ul class="hours">
                    <li><strong>Lundi, mardi</strong><span>9h00–18h30</span></li>
                    <li><strong>Mercredi</strong><span>Fermé</span></li>
                    <li><strong>Jeudi, vendredi</strong><span>9h00–18h30</span></li>
                    <li><strong>Samedi</strong><span>9h00–12h00</span></li>
                    <li><strong>Dimanche</strong><span>Fermé</span></li>
                </ul>
            </div>

            {# --- Carte 2 : prendre rdv --- #}
            <div class="card-box rdv">
                <h3>Prenez rendez-vous<br> dès maintenant</h3>
                <p class="rdv-text">
                    Pour prendre rendez-vous, contactez-moi par téléphone
                    ou cliquez sur le bouton ci-dessous.
                </p>
                <a href="{{ path('app_appointement') }}" class="btn-primary">Votre rendez-vous</a>
            </div>

        </div>
    </section>

    <div class="separator"><span></span></div>

{% endblock %}




