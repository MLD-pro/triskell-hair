{% extends 'base.html.twig' %}

{% block title %}Lieux de déplacements{% endblock %}

{% block body %}
    <div class="intro-banner">
        <h1>Lieux de déplacements</h1>
        <p>Suis-je disponible dans votre ville ou commune ?</p>
    </div>

    <section class="location-search">
        <h2>Recherchez votre ville ou commune</h2>
        <p>Service de coiffure à domicile dans un rayon de 30 km autour de Quimperlé</p>

        <div id="search-message" class="message" style="display:none;"></div>

        {{ form_start(form, {'attr': {'id': 'location-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn-primary">Rechercher</button>
        {{ form_end(form) }}
    </section>

    <section class="location-results">
        {% if locations is not empty %}
            <h2>Résultats :</h2>
            <ul>
                {% for location in locations %}
                    <li>{{ location.city }} ({{ location.zipcode }})</li>
                {% endfor %}
            </ul>
        {% elseif isSubmitted %}
            <p>Aucun résultat trouvé.</p>
        {% endif %}
    </section>

    <div id="map" style="height: 450px; margin-top: 40px; border-radius: 12px;"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('location') }}
{% endblock %}



