{% extends 'base.html.twig' %}

{% block title %}Prendre rendez-vous{% endblock %}

{% block body %}
    <h1>Demande de rendez-vous</h1>
    <p>Rempliussez ce formulaire, je vous recontacte pour comfirmer l'horaire</p>

    {{ form_start(form) }}

    <div style="width:48%; float:left; margin-right:4%;">
        <h3>Vos informations</h3>
        {{ form_row(form.civility) }}
        {{ form_row(form.lastName) }}
        {{ form_row(form.email) }}
        {{ form_row(form.service) }}
    </div>

    <div style="width:48%; float:left;">

        {{ form_row(form.firstName) }}
        {{ form_row(form.phone) }}

        <div id="choice1">
            {{ form_row(form.date1) }}
            {{ form_row(form.moment1) }}
        </div>

        <div id="choice2" style="display:none;">
            {{ form_row(form.date2) }}
            {{ form_row(form.moment2) }}
        </div>

        <div id="choice3" style="display:none;">
            {{ form_row(form.date3) }}
            {{ form_row(form.moment3) }}
        </div>
    </div>

    <div style="clear:both;"></div>

    {{ form_row(form.address) }}

    <div style="width:48%; float:left; margin-right:4%;">
        {{ form_row(form.zipcode) }}
    </div>
    <div style="width:48%; float:left;">
        {{ form_row(form.city) }}
    </div>
    <div style="clear:both;"></div>

    {{ form_row(form.message) }}

    <button type="submit">Envoyer ma demande</button>

    {{ form_end(form) }}
{% endblock %}


