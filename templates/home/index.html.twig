{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil - Triskell'Hair{% endblock %}

{% block body %}

    <section id="apropos" class="home-section about">
        <div class="about-card">
            <div class="about-image">
                <img src="{{ asset('images/home-a-propos.jpg') }}" alt="Coiffure mariage avec des bijoux pour accessoiriser la coiffure">
            </div>
            <div class="about-text">
                <h3>À PROPOS</h3>
                <h2>Coiffeuse à domicile</h2>
                <p>
                    Avec une approche<br>
                    professionnelle et<br>
                    personnalisée, je me déplace à<br>
                    votre domicile pour réaliser la<br>
                    coiffure de vos rêves.
                </p>
            </div>
        </div>
    </section>

    <div class="separator">
        <span></span>
    </div>

    <section class="home-section rendezvous">
        <h2>Comment se déroule le <br>
            rendez-vous&nbsp;?</h2>
        <a href="{{ path('app_appointement') }}" class="btn-primary">Votre rendez-vous</a>
    </section>

    <div class="separator">
        <span></span>
    </div>

    <section class="home-section prestations">
        <div class="prestations-card">
            <div class="prestations-text">
                <h2>Coupe, couleur,<br>
                    coiffure...</h2>
                <a href="{{ path('app_services') }}" class="btn-primary">Tarifs et prestations</a>
            </div>
            <div class="prestations-image">
                <img src="{{ asset('images/home-tarif-p.jpg') }}" alt="Image d'une coupe en cours avec les ciseaux et un peigne">
            </div>
        </div>
    </section>

    <div class="separator">
        <span></span>
    </div>

    <section class="home-section localisation">
        <div class="map-info-container">

            <div class="map">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.692874797146!2d-3.554476684531846!3d47.872021579202206!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48177f4e40a37e0f%3A0x40819a5fd979bb0!2sQuimperl%C3%A9%2C%2029300!5e0!3m2!1sfr!2sfr!4v1730151000000!5m2!1sfr!2sfr"
                    width="100%" height="400"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>

            <div class="info">
                <h3><strong>|</strong> Coordonnées</h3>

                <p>
                    <img src="{{ asset('images/icon-phone.png') }}" alt="Téléphone">
                    06.40.75.81.29
                </p>
                <p>
                    <img src="{{ asset('images/icon-mail.png') }}" alt="Email">
                    triskellhair@gmail.com
                </p>

                <p>
                    Claire Perven, coiffeuse à domicile.<br>
                    Dans une zone de 30 km autour de Quimperlé.
                </p>

                <ul class="hours">
                    <li><strong>Lundi, mardi </strong> 9h00–18h30</li>
                    <li><strong>Mercredi </strong> Fermé</li>
                    <li><strong>Jeudi, vendredi </strong> 9h00–18h30</li>
                    <li><strong>Samedi </strong> 9h00–12h00</li>
                    <li><strong>Dimanche </strong> Fermé</li>
                </ul>
            </div>
        </div>
    </section>

    <div class="separator">
        <span></span>
    </div>

{% endblock %}

