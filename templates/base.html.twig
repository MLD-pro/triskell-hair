<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}Triskell'Hair{% endblock %}</title>

    {# police d'écriture #}
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600&display=swap" rel="stylesheet">

    {# CSS compilé avec Webpack Encore #}
    {{ encore_entry_link_tags('app') }}

    {# JS compilé avec Webpack Encore #}
    {{ encore_entry_script_tags('app') }}
</head>
<body>
<!-- HEADER -->
<header class="site-header">
    <!-- Bande supérieure : logo + burger -->
    <div class="header-top">
        <a href="{{ path('app_home') }}" class="logo">
            <img src="{{ asset('images/logo_h.png') }}" alt="Le logo de Triskell'Hair">
            Triskell'Hair
        </a>

        <button class="burger" id="burger-btn" aria-label="Menu">
            <span class="line"></span>
            <span class="line"></span>
            <span class="line"></span>
        </button>
    </div>

    {# Image de fond + phrase d’accroche #}
    <section class="hook" style="background-image: url('{{ asset('images/header-bg.png') }}');">
        <div class="hook-content">
            <h1>
                De beaux cheveux ça ne se fait pas par hasard,<br>
                ça se fait sur rendez-vous.
            </h1>
        </div>
    </section>

    {# Overlay et menu latéral #}
    <div class="nav-overlay" id="nav-overlay"></div>

    <nav class="nav-menu" id="nav-menu">
        <a href="{{ path('app_home') }}">Page d'accueil</a>
        <a href="{{ path('app_home') }}#apropos">À propos</a>
        <a href="{{ path('app_services') }}">Prestations & tarifs</a>
        <a href="{{ path('app_location') }}">Lieux de déplacements</a>
        <a href="{{ path('app_appointement') }}">Prendre rendez-vous</a>
        <a href="{{ path('app_achievements') }}">Réalisations</a>

        {% if app.user %}
            <span>{{ app.user.civility }} {{ app.user.lastName|title }} {{ app.user.firstName|capitalize }}</span>
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
        {% else %}
            <a href="{{ path('app_auth') }}">Se connecter / S'inscrire</a>
        {% endif %}
    </nav>
</header>

{# BANDE DÉFILANTE #}
<section class="notice-band" role="region" aria-label="Annonce">
    <div class="band">
        <div class="scrolling-strip" id="scrolling-strip">
            <a class="band-item" href="{{ path('app_appointement') }}">DEMANDER UNE RÉSERVATION&nbsp;!</a>
            <a class="band-item" href="{{ path('app_appointement') }}">DEMANDER UNE RÉSERVATION&nbsp;!</a>
            <a class="band-item" href="{{ path('app_appointement') }}">DEMANDER UNE RÉSERVATION&nbsp;!</a>
        </div>
    </div>
</section>


<!-- MESSAGES FLASH pour les messages temporaires -->
<div class="flash-popup-container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-popup {{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- CONTENU PAGE -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- FOOTER -->
<footer class="site-footer">
    <div class="footer-container">
        <!-- Bloc logo -->
        <div class="footer-logo">
            <img src="{{ asset('images/logo-grey-footer.png') }}" alt="Le logo Triskell'Hair">
            <p>Triskell'Hair</p>
        </div>

        <!-- Bloc Liens rapides -->
        <div class="footer-links">
            <h3>Lien rapide</h3>
            <ul>
                <li><a href="{{ path('app_home') }}">Page d'accueil</a></li>
                <li><a href="{{ path('app_home') }}#apropos">À propos</a></li>
                <li><a href="{{ path('app_services') }}">Prestations tarifs</a></li>
                <li><a href="{{ path('app_location') }}">Lieux de déplacement</a></li>
                <li><a href="{{ path('app_achievements') }}">Réalisations</a></li>
                <li><a href="{{ path('app_appointement') }}">Prendre rendez-vous</a></li>
                <li>
                    {% if app.user %}
                        <a href="{{ path('app_logout') }}">Mon compte</a>
                    {% else %}
                        <a href="{{ path('app_auth') }}">S'inscrire</a>
                    {% endif %}
                </li>
            </ul>
        </div>

        <!-- Bloc Politique -->
        <div class="footer-legal">
            <h3>Politique de confidentialité</h3>
            <ul>
                <li><a href="{{ path('app_mentions') }}">Mentions légales</a></li>
                <li><a href="{{ path('app_confidentialite') }}">Politique de confidentialité</a></li>
                <li><a href="#">CGU</a></li>
                <li><a href="#">Vie privée</a></li>
            </ul>
        </div>

        <!-- Bloc Réseaux -->
        <div class="footer-socials">
            <p>Réseaux sociaux :</p>
            <div class="social-icons">
                <a href="https://www.facebook.com/p/TriskellHair-100054388276598/?locale=fr_FR" target="_blank" rel="noopener" aria-label="Facebook">
                    <img src="{{ asset('images/facebook_icon.png') }}" alt="Facebook">
                </a>
                <a href="https://www.instagram.com/triskellhair/?hl=fr" target="_blank" rel="noopener" aria-label="Instagram">
                    <img src="{{ asset('images/instagram_icon.png') }}" alt="Instagram">
                </a>
                <a href="https://www.tiktok.com" target="_blank" rel="noopener" aria-label="TikTok">
                    <img src="{{ asset('images/tiktok_icon.png') }}" alt="TikTok">
                </a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; 2025 Triskell'Hair. Tous droits réservés.</p>
    </div>
</footer>
</body>
</html>



