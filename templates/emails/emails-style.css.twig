/* === Styles communs aux emails === */

body {
    font-family: Arial, sans-serif;
    color: #483D3D;
    background-color: #fffaf0;
    margin: 0;
    padding: 20px;
}

.container {
    background: #ffffff;
    border-radius: 10px;
    padding: 25px;
    max-width: 600px;
    margin: auto;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
}

h2 {
    color: #B4A37D;
    font-weight: 600;
}

h3 {
    color: #483D3D;
    margin-top: 25px;
}

p, li {
    line-height: 1.6;
    font-size: 1rem;
}

ul {
    padding-left: 20px;
    margin: 15px 0;
}

a.button {
    display: inline-block;
    background-color: #B4A37D;
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 50px;
    text-decoration: none;
    margin-top: 20px;
}

a.button:hover {
    background-color: #a0916c;
}

/* --- Bloc informations client --- */
ul.client-info li strong {
    color: #B4A37D;
}

/* --- Bloc dates --- */
ul.dates li {
    margin-bottom: 4px;
}

/* --- Message client --- */
.client-message {
    white-space: pre-line;
    background: #fff8e0;
    padding: 10px 15px;
    border-radius: 8px;
    border: 1px solid #e8ddc5;
    font-style: italic;
}

/* --- Paragraphe d’invitation admin --- */
.admin-invite {
    margin-top: 25px;
}

