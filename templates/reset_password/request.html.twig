{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="container-centered reset-container">
        <h1>Mot de passe oublié</h1>

        <p>
            Entrez votre adresse email ci-dessous et nous vous enverrons un lien pour réinitialiser
            votre mot de passe.
        </p>

        {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <button type="submit" class="btn-primary">Envoyer le lien</button>
        {{ form_end(requestForm) }}
    </div>
{% endblock %}

